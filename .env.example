# Mailbox and Gemini settings for the email agent. Copy this file to .env.
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=agent@example.com
EMAIL_PASSWORD=replace-me
EMAIL_FROM=agent@example.com
EMAIL_FOLDER=INBOX
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash-lite
